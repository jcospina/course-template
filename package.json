{
  "name": "interactive-course-template",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "description": "A reusable template for interactive, tutor-style technical courses: MDX lessons, live Sandpack playgrounds, predict/quiz/exercise components, on a Vite + React + TypeScript base.",
  "scripts": {
    "dev": "bun run --bun vite",
    "build": "bun run --bun tsc -b && bun run --bun vite build",
    "preview": "bun run --bun vite preview",
    "typecheck": "bun run --bun tsc -b --noEmit",
    "check:mdx": "bun scripts/check-mdx.mjs",
    "test": "bun test tests/*.test.ts",
    "test:browser": "bun run --bun playwright test",
    "schema:types": "bun scripts/generate-example-types.ts",
    "presets": "bun scripts/presets.ts",
    "example:new": "bun scripts/example-new.ts",
    "validate:course": "bun scripts/validate-course.ts",
    "verify:examples": "bun scripts/verify-examples.ts",
    "verify:course": "bun scripts/verify-course.ts",
    "verify:generated-courses": "bun scripts/verify-generated-courses.ts"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-vue": "0.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@codesandbox/nodebox": "0.1.8",
    "@codesandbox/sandpack-react": "^2.19.10",
    "@electric-sql/pglite": "0.5.8",
    "@mdx-js/react": "^3.1.0",
    "@replit/codemirror-lang-svelte": "6.0.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.0",
    "@playwright/test": "^1.63.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "22.18.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "8.20.0",
    "json-schema-to-typescript": "16.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "5.9.3",
    "vite": "^6.0.7"
  },
  "overrides": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-vue": "0.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13"
  }
}
