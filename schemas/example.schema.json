{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExampleManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "preset",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "preset": {
      "enum": [
        "html-css",
        "javascript",
        "typescript",
        "react",
        "react-ts",
        "vue",
        "vue-ts",
        "svelte",
        "svelte-ts",
        "angular",
        "node",
        "node-ts",
        "postgres",
        "custom-web"
      ]
    },
    "title": {
      "type": "string"
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "solutionSources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "solutionRemoveFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "editor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activeFile": {
          "type": "string"
        },
        "hiddenFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "readOnlyFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed"
      ],
      "properties": {
        "seed": {
          "type": "string"
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "browser-jest",
            "sql-result",
            "sql-state",
            "node-assert",
            "node-http"
          ]
        },
        "sources": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "columns",
              "rows"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "integer",
                "minimum": 0
              },
              "query": {
                "type": "string",
                "minLength": 1
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": [
                          "string",
                          "boolean",
                          "null"
                        ]
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type",
                          "value"
                        ],
                        "properties": {
                          "type": {
                            "enum": [
                              "decimal",
                              "bigint",
                              "date"
                            ]
                          },
                          "value": {
                            "type": "string"
                          }
                        }
                      }
                    ]
                  }
                }
              },
              "ordered": {
                "type": "boolean"
              }
            }
          }
        },
        "httpCases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "request",
              "status"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "request": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "method",
                  "path"
                ],
                "properties": {
                  "method": {
                    "enum": [
                      "GET",
                      "POST",
                      "PUT",
                      "PATCH",
                      "DELETE",
                      "HEAD"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^/(?!/)"
                  },
                  "headers": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "body": {
                    "type": "string"
                  }
                }
              },
              "status": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "body": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "entry",
        "activeFile",
        "output"
      ],
      "properties": {
        "environment": {
          "enum": [
            "static",
            "parcel",
            "create-react-app",
            "vue-cli",
            "angular-cli",
            "svelte",
            "node"
          ]
        },
        "entry": {
          "type": "string"
        },
        "activeFile": {
          "type": "string"
        },
        "output": {
          "enum": [
            "preview",
            "console"
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "starterChecks": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "rejectedSources": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "steps": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "enum": [
                  "console",
                  "preview",
                  "click",
                  "checks",
                  "sql",
                  "http"
                ]
              },
              "text": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "button",
                  "link",
                  "checkbox",
                  "textbox"
                ]
              },
              "name": {
                "type": "string"
              },
              "outcome": {
                "enum": [
                  "pass",
                  "fail"
                ]
              },
              "request": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "method",
                  "path"
                ],
                "properties": {
                  "method": {
                    "enum": [
                      "GET",
                      "POST",
                      "PUT",
                      "PATCH",
                      "DELETE",
                      "HEAD"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^/(?!/)"
                  },
                  "headers": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "body": {
                    "type": "string"
                  }
                }
              },
              "status": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "body": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "startPath": {
          "type": "string"
        }
      }
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "path"
        ],
        "properties": {
          "method": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "HEAD"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/(?!/)"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "body": {
            "type": "string"
          }
        }
      }
    }
  }
}
